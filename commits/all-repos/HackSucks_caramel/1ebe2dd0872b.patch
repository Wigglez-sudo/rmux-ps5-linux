From 1ebe2dd0872be36fc3a6ad99e1e3ddb7f1b3c527 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Sat, 7 Nov 2026 23:06:55 +0100
Subject: [PATCH] amdgpu: gladius: embed both cp microcode tables and pick one
 by 0x203e

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 build.sh                                 |  13 +++++++++
 drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c    |  33 ++++++++++++++++-------
 extra_firmware/amdgpu/gladius_a_ce.bin   | Bin 0 -> 8832 bytes
 extra_firmware/amdgpu/gladius_a_me.bin   | Bin 0 -> 17024 bytes
 extra_firmware/amdgpu/gladius_a_mec.bin  | Bin 0 -> 17024 bytes
 extra_firmware/amdgpu/gladius_a_mec2.bin | Bin 0 -> 17024 bytes
 extra_firmware/amdgpu/gladius_a_pfp.bin  | Bin 0 -> 17024 bytes
 extra_firmware/amdgpu/gladius_b_ce.bin   | Bin 0 -> 8832 bytes
 extra_firmware/amdgpu/gladius_b_me.bin   | Bin 0 -> 17024 bytes
 extra_firmware/amdgpu/gladius_b_mec.bin  | Bin 0 -> 17024 bytes
 extra_firmware/amdgpu/gladius_b_mec2.bin | Bin 0 -> 17024 bytes
 extra_firmware/amdgpu/gladius_b_pfp.bin  | Bin 0 -> 17024 bytes
 extra_firmware/amdgpu/gladius_rlc.bin    | Bin 0 -> 8448 bytes
 extra_firmware/amdgpu/gladius_sdma.bin   | Bin 0 -> 4456 bytes
 extra_firmware/amdgpu/gladius_sdma1.bin  | Bin 0 -> 4456 bytes
 15 files changed, 36 insertions(+), 10 deletions(-)
 create mode 100644 extra_firmware/amdgpu/gladius_a_ce.bin
 create mode 100644 extra_firmware/amdgpu/gladius_a_me.bin
 create mode 100644 extra_firmware/amdgpu/gladius_a_mec.bin
 create mode 100644 extra_firmware/amdgpu/gladius_a_mec2.bin
 create mode 100644 extra_firmware/amdgpu/gladius_a_pfp.bin
 create mode 100644 extra_firmware/amdgpu/gladius_b_ce.bin
 create mode 100644 extra_firmware/amdgpu/gladius_b_me.bin
 create mode 100644 extra_firmware/amdgpu/gladius_b_mec.bin
 create mode 100644 extra_firmware/amdgpu/gladius_b_mec2.bin
 create mode 100644 extra_firmware/amdgpu/gladius_b_pfp.bin
 create mode 100644 extra_firmware/amdgpu/gladius_rlc.bin
 create mode 100644 extra_firmware/amdgpu/gladius_sdma.bin
 create mode 100644 extra_firmware/amdgpu/gladius_sdma1.bin

diff --git a/build.sh b/build.sh
index a4429622a5e6..3269dea7a5e5 100755
--- a/build.sh
+++ b/build.sh
@@ -17,6 +17,19 @@ REQUIRED_PS4_AMDGPU_FW=(
     "amdgpu/liverpool_sdma1.bin"
     "amdgpu/liverpool_refresh_uvd.bin"
     "amdgpu/liverpool_vce.bin"
+    "amdgpu/gladius_a_ce.bin"
+    "amdgpu/gladius_a_me.bin"
+    "amdgpu/gladius_a_mec.bin"
+    "amdgpu/gladius_a_mec2.bin"
+    "amdgpu/gladius_a_pfp.bin"
+    "amdgpu/gladius_b_ce.bin"
+    "amdgpu/gladius_b_me.bin"
+    "amdgpu/gladius_b_mec.bin"
+    "amdgpu/gladius_b_mec2.bin"
+    "amdgpu/gladius_b_pfp.bin"
+    "amdgpu/gladius_rlc.bin"
+    "amdgpu/gladius_sdma.bin"
+    "amdgpu/gladius_sdma1.bin"
 )
 declare -A FIRMWARE_URL_OVERRIDES
 FIRMWARE_URL_OVERRIDES["mrvl/sd8797_uapsta.bin"]="useCustomFirmware"
diff --git a/drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c b/drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c
index 6df877d0bab4..db3c4e5d9775 100644
--- a/drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c
+++ b/drivers/gpu/drm/amd/amdgpu/gfx_v7_0.c
@@ -294,12 +294,17 @@ MODULE_FIRMWARE("amdgpu/liverpool_rlc.bin");
 MODULE_FIRMWARE("amdgpu/liverpool_mec.bin");
 MODULE_FIRMWARE("amdgpu/liverpool_mec2.bin");
 
-MODULE_FIRMWARE("amdgpu/gladius_pfp.bin");
-MODULE_FIRMWARE("amdgpu/gladius_me.bin");
-MODULE_FIRMWARE("amdgpu/gladius_ce.bin");
+MODULE_FIRMWARE("amdgpu/gladius_a_pfp.bin");
+MODULE_FIRMWARE("amdgpu/gladius_a_me.bin");
+MODULE_FIRMWARE("amdgpu/gladius_a_ce.bin");
+MODULE_FIRMWARE("amdgpu/gladius_a_mec.bin");
+MODULE_FIRMWARE("amdgpu/gladius_a_mec2.bin");
+MODULE_FIRMWARE("amdgpu/gladius_b_pfp.bin");
+MODULE_FIRMWARE("amdgpu/gladius_b_me.bin");
+MODULE_FIRMWARE("amdgpu/gladius_b_ce.bin");
+MODULE_FIRMWARE("amdgpu/gladius_b_mec.bin");
+MODULE_FIRMWARE("amdgpu/gladius_b_mec2.bin");
 MODULE_FIRMWARE("amdgpu/gladius_rlc.bin");
-MODULE_FIRMWARE("amdgpu/gladius_mec.bin");
-MODULE_FIRMWARE("amdgpu/gladius_mec2.bin");
 
 static const struct amdgpu_gds_reg_offset amdgpu_gds_reg_offset[] = {
 	{mmGDS_VMID0_BASE, mmGDS_VMID0_SIZE, mmGDS_GWS_VMID0, mmGDS_OA_VMID0},
@@ -1537,6 +1542,7 @@ static void gfx_v7_0_free_microcode(struct amdgpu_device *adev)
 static int gfx_v7_0_init_microcode(struct amdgpu_device *adev)
 {
 	const char *chip_name;
+	const char *cp_name;
 	int err;
 
 	DRM_DEBUG("\n");
@@ -1568,27 +1574,34 @@ static int gfx_v7_0_init_microcode(struct amdgpu_device *adev)
 		return -EINVAL;
 	}
 
+	cp_name = chip_name;
+	if (adev->asic_type == CHIP_GLADIUS) {
+		cp_name = (RREG32(0x203e) & 1) ? "gladius_a" : "gladius_b";
+		dev_info(adev->dev, "Gladius cp microcode %s (0x203e 0x%08x)\n",
+			 cp_name, RREG32(0x203e));
+	}
+
 	err = amdgpu_ucode_request(adev, &adev->gfx.pfp_fw,
 				   AMDGPU_UCODE_REQUIRED,
-				   "amdgpu/%s_pfp.bin", chip_name);
+				   "amdgpu/%s_pfp.bin", cp_name);
 	if (err)
 		goto out;
 
 	err = amdgpu_ucode_request(adev, &adev->gfx.me_fw,
 				   AMDGPU_UCODE_REQUIRED,
-				   "amdgpu/%s_me.bin", chip_name);
+				   "amdgpu/%s_me.bin", cp_name);
 	if (err)
 		goto out;
 
 	err = amdgpu_ucode_request(adev, &adev->gfx.ce_fw,
 				   AMDGPU_UCODE_REQUIRED,
-				   "amdgpu/%s_ce.bin", chip_name);
+				   "amdgpu/%s_ce.bin", cp_name);
 	if (err)
 		goto out;
 
 	err = amdgpu_ucode_request(adev, &adev->gfx.mec_fw,
 				   AMDGPU_UCODE_REQUIRED,
-				   "amdgpu/%s_mec.bin", chip_name);
+				   "amdgpu/%s_mec.bin", cp_name);
 	if (err)
 		goto out;
 
@@ -1597,7 +1610,7 @@ static int gfx_v7_0_init_microcode(struct amdgpu_device *adev)
 			(adev->asic_type == CHIP_GLADIUS)) {
 		err = amdgpu_ucode_request(adev, &adev->gfx.mec2_fw,
 					   AMDGPU_UCODE_REQUIRED,
-					   "amdgpu/%s_mec2.bin", chip_name);
+					   "amdgpu/%s_mec2.bin", cp_name);
 		if (err)
 		{
 			pr_err("gfx7: Failed to validate ucode firmware \"%s\"\n", chip_name);
