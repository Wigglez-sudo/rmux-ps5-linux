From 7807464f6d4aedb4fa8be12e456e2bd032ca2581 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Fri, 6 Nov 2026 21:34:10 +0100
Subject: [PATCH] ps4: merge the southbridge headers and rename the drivers

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 arch/x86/include/asm/ps4.h                    |   8 +-
 arch/x86/platform/ps4/ps4.c                   |   8 +-
 drivers/ata/ahci.c                            | 212 ++++++------
 drivers/ata/ahci.h                            |  10 +-
 drivers/net/ethernet/marvell/sky2.c           |  10 +-
 drivers/ps4/Makefile                          |  10 +-
 drivers/ps4/aeolia.h                          | 115 -------
 drivers/ps4/baikal.h                          | 165 ---------
 drivers/ps4/ps4-buzzer.c                      |   2 +-
 drivers/ps4/ps4-fan.c                         |   2 +-
 drivers/ps4/ps4-led.c                         |   2 +-
 drivers/ps4/ps4sb.h                           | 242 ++++++++++++-
 drivers/ps4/{ps4-apcie.c => sb-aeolia.c}      | 304 ++++++++---------
 drivers/ps4/{ps4-bpcie.c => sb-baikal.c}      | 322 +++++++++---------
 drivers/ps4/{icc/i2c.c => sb-icc-i2c.c}       |  12 +-
 ...4-apcie-pwrbutton.c => sb-icc-pwrbutton.c} |  14 +-
 drivers/ps4/{ps4-sflash.c => sb-sflash.c}     |   2 +-
 drivers/ps4/{ps4-sflash.h => sb-sflash.h}     |   0
 drivers/usb/host/xhci-aeolia.c                |   6 +-
 19 files changed, 702 insertions(+), 744 deletions(-)
 delete mode 100644 drivers/ps4/aeolia.h
 delete mode 100644 drivers/ps4/baikal.h
 rename drivers/ps4/{ps4-apcie.c => sb-aeolia.c} (61%)
 rename drivers/ps4/{ps4-bpcie.c => sb-baikal.c} (61%)
 rename drivers/ps4/{icc/i2c.c => sb-icc-i2c.c} (94%)
 rename drivers/ps4/{ps4-apcie-pwrbutton.c => sb-icc-pwrbutton.c} (82%)
 rename drivers/ps4/{ps4-sflash.c => sb-sflash.c} (99%)
 rename drivers/ps4/{ps4-sflash.h => sb-sflash.h} (100%)

diff --git a/arch/x86/include/asm/ps4.h b/arch/x86/include/asm/ps4.h
index 2694d59324c0..537b776b5e1c 100644
--- a/arch/x86/include/asm/ps4.h
+++ b/arch/x86/include/asm/ps4.h
@@ -32,8 +32,8 @@ extern unsigned long ps4_calibrate_tsc(void);
  * Returns 1 or count, depending on IRQ allocation constraints, or negative on
  * error. Assigned IRQ(s) start at dev->irq.
  */
-extern int apcie_assign_irqs(struct pci_dev *dev, int nvec);
-extern void apcie_free_irqs(unsigned int virq, unsigned int nr_irqs);
+extern int aeolia_assign_irqs(struct pci_dev *dev, int nvec);
+extern void aeolia_free_irqs(unsigned int virq, unsigned int nr_irqs);
 
 typedef void (*ps4sb_icc_event_fn)(void *ctx, u16 minor, const u8 *data,
 				   u16 length);
@@ -49,8 +49,8 @@ extern int ps4sb_status(void);
 extern int ps4sb_assign_irqs(struct pci_dev *dev, int nvec);
 extern void ps4sb_free_irqs(unsigned int virq, unsigned int nr_irqs);
 extern bool ps4_is_baikal(void);
-extern int bpcie_assign_irqs(struct pci_dev *dev, int nvec);
-extern void bpcie_free_irqs(unsigned int virq, unsigned int nr_irqs);
+extern int baikal_assign_irqs(struct pci_dev *dev, int nvec);
+extern void baikal_free_irqs(unsigned int virq, unsigned int nr_irqs);
 extern void ps4sb_icc_reboot(void);
 extern int ps4sb_icc_cmd(u8 major, u16 minor, const void *data,
 			 u16 length, void *reply, u16 reply_length);
diff --git a/arch/x86/platform/ps4/ps4.c b/arch/x86/platform/ps4/ps4.c
index 564eb3112751..9dade8e2612c 100644
--- a/arch/x86/platform/ps4/ps4.c
+++ b/arch/x86/platform/ps4/ps4.c
@@ -56,17 +56,17 @@ EXPORT_SYMBOL_GPL(ps4sb_status);
 
 int ps4sb_assign_irqs(struct pci_dev *dev, int nvec)
 {
-	return is_baikal ? bpcie_assign_irqs(dev, nvec) :
-			   apcie_assign_irqs(dev, nvec);
+	return is_baikal ? baikal_assign_irqs(dev, nvec) :
+			   aeolia_assign_irqs(dev, nvec);
 }
 EXPORT_SYMBOL_GPL(ps4sb_assign_irqs);
 
 void ps4sb_free_irqs(unsigned int virq, unsigned int nr_irqs)
 {
 	if (is_baikal)
-		bpcie_free_irqs(virq, nr_irqs);
+		baikal_free_irqs(virq, nr_irqs);
 	else
-		apcie_free_irqs(virq, nr_irqs);
+		aeolia_free_irqs(virq, nr_irqs);
 }
 EXPORT_SYMBOL_GPL(ps4sb_free_irqs);
 
