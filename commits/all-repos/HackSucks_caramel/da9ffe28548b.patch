 .../gpu/drm/amd/amdgpu/vce_liverpool_compat.c | 859 ++++++++++++++++++
 .../gpu/drm/amd/amdgpu/vce_liverpool_sps.h    | 193 ++++
 .../drm/amd/amdgpu/vce_liverpool_vectors.h    |  53 ++
 drivers/ps4/Makefile                          |   2 +-
 extra_firmware/amdgpu/liverpool_vce.bin       | Bin 0 -> 52056 bytes
