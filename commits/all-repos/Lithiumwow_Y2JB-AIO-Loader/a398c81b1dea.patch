From a398c81b1dea080ac8cdfc09963a560d07a17370 Mon Sep 17 00:00:00 2001
From: rmuxnet <116457149+rmuxnet@users.noreply.github.com>
Date: Sat, 17 Jan 2026 22:41:19 +0100
Subject: [PATCH] feat(backend) fix Toast Messages in Settings.js

---
 static/settings.js | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/static/settings.js b/static/settings.js
index 62c6158..20c00a8 100644
--- a/static/settings.js
+++ b/static/settings.js
@@ -17,7 +17,7 @@ async function loadSettings() {
 
     } catch (error) {
         console.error('Error loading settings:', error);
-        showToast('Failed to load settings', 'error');
+        Toast.show('Failed to load settings', 'error');
     }
 }
 
@@ -44,12 +44,12 @@ async function saveAllSettings() {
         const result = await response.json();
 
         if (result.success) {
-            showToast('Settings saved successfully!', 'success');
+            Toast.show('Settings saved successfully!', 'success');
         } else {
-            showToast('Error: ' + result.error, 'error');
+            Toast.show('Error: ' + result.error, 'error');
         }
     } catch (error) {
         console.error('Error saving settings:', error);
-        showToast('Connection error while saving', 'error');
+        Toast.show('Connection error while saving', 'error');
     }
 }
\ No newline at end of file
