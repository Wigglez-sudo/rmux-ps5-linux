--- a/static/index.js
+++ b/static/index.js
@@ -340,7 +340,8 @@ async function loadsettings() {
 
 async function togglePayloadIndex(filename, checkbox) {
     const enabled = checkbox.checked;
-    const configKey = filename.split('/').pop();
