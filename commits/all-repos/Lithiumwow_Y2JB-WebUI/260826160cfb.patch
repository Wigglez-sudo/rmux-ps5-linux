     <script src="{{ url_for('static', filename='color_mode.js') }}" defer></script> 
 </head>
 <body class="font-sans antialiased min-h-screen flex flex-col p-6 max-w-2xl mx-auto bg-oled-base text-gray-200 transition-colors duration-300">
