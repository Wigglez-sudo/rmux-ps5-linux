+            </div>
+
             <div class="mt-3 p-3 bg-yellow-500/10 border border-yellow-500/20 rounded-lg flex gap-3 items-start">
                  <i class="fa-solid fa-triangle-exclamation text-yellow-500 mt-0.5 text-xs"></i>
                  <p class="text-[10px] opacity-80 leading-relaxed text-yellow-200">
