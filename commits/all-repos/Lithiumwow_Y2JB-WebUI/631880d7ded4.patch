From 631880d7ded4517d459927c459325c25cf2fef7e Mon Sep 17 00:00:00 2001
From: rmuxnet <116457149+rmuxnet@users.noreply.github.com>
Date: Sat, 17 Jan 2026 14:12:13 +0100
Subject: [PATCH] UI: Repo Manager:  Improve Layout

- Convert the "Configuration Guide" in templates/repos.html to a collapsible <details> element.
- Reduce visual clutter to prioritize the repository list view.
- Improve vertical spacing for better usability on smaller screens.
---
 templates/repos.html | 19 ++++++++++++-------
 1 file changed, 12 insertions(+), 7 deletions(-)

diff --git a/templates/repos.html b/templates/repos.html
index 11ffb14..bb0d4ea 100644
--- a/templates/repos.html
+++ b/templates/repos.html
@@ -56,13 +56,18 @@ <h1 class="text-2xl font-bold tracking-tight">Repository Manager</h1>
         <div id="loading" class="p-8 text-center opacity-50">Loading repositories...</div>
     </div>
 
-    <div class="surface border rounded-2xl p-6 transition-all hover:border-brand-blue/30 shadow-sm">
-        <h3 class="text-lg font-bold mb-6 flex items-center gap-2">
-            <i class="fa-regular fa-circle-question text-brand-light"></i> 
-            <span>Configuration Guide</span>
-        </h3>
+    <details class="surface border rounded-2xl p-6 transition-all hover:border-brand-blue/30 shadow-sm group">
+        <summary class="flex items-center justify-between cursor-pointer list-none select-none">
+            <h3 class="text-lg font-bold flex items-center gap-2">
+                <i class="fa-regular fa-circle-question text-brand-light"></i> 
+                <span>Configuration Guide</span>
+            </h3>
+            <span class="w-8 h-8 flex items-center justify-center rounded-full bg-white/5 group-hover:bg-brand-blue/20 transition-colors">
+                <i class="fa-solid fa-chevron-down text-xs transition-transform duration-300 group-open:rotate-180"></i>
+            </span>
+        </summary>
         
-        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm">
+        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-sm mt-6 animate-fade-in">
             <div class="space-y-6">
                 <div>
                     <h4 class="font-bold text-brand-light flex items-center gap-2 mb-2">
@@ -146,7 +151,7 @@ <h4 class="font-bold opacity-80 text-xs uppercase tracking-wide">Example Configu
                 </div>
             </div>
         </div>
-    </div>
+    </details>
 
     <div id="repoModal" class="fixed inset-0 bg-black/80 hidden flex items-center justify-center z-50 backdrop-blur-sm transition-opacity">
         <div class="surface border rounded-2xl p-6 w-full max-w-md shadow-2xl transform transition-all scale-100">
