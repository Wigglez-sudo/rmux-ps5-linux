From 9b9d0dd1d68a94948add09bea534361785fe7c4f Mon Sep 17 00:00:00 2001
From: rmuxnet <116457149+rmuxnet@users.noreply.github.com>
Date: Fri, 16 Jan 2026 12:41:01 +0100
Subject: [PATCH] Add repos.json with payload repository configurations

Introduces static/config/repos.json to define sources and save paths for various payloads, supporting both direct and release-based downloads.
---
 static/config/repos.json | 31 +++++++++++++++++++++++++++++++
 1 file changed, 31 insertions(+)
 create mode 100644 static/config/repos.json

diff --git a/static/config/repos.json b/static/config/repos.json
new file mode 100644
index 0000000..73ddd0b
--- /dev/null
+++ b/static/config/repos.json
@@ -0,0 +1,31 @@
+{
+    "lapse.js": {
+        "type": "direct",
+        "url": "https://raw.githubusercontent.com/Gezine/Y2JB/main/payloads/lapse.js",
+        "save_path": "payloads/js/lapse.js"
+    },
+    "kstuff.elf": {
+        "type": "release",
+        "repo": "EchoStretch/kstuff",
+        "asset_pattern": "kstuff.elf",
+        "save_path": "payloads/kstuff.elf"
+    },
+    "ftpsrv.elf": {
+        "type": "release",
+        "repo": "drakmor/ftpsrv",
+        "asset_pattern": "ftpsrv-ps5.elf",
+        "save_path": "payloads/ftpsrv-ps5.elf"
+    },
+    "shadowmount.elf": {
+        "type": "release",
+        "repo": "adel-ailane/ShadowMount",
+        "asset_pattern": "shadowmount.elf",
+        "save_path": "payloads/shadowmount.elf"
+    },
+    "notify.elf": {
+        "type": "release",
+        "repo": "adel-ailane/ShadowMount",
+        "asset_pattern": "notify.elf",
+        "save_path": "payloads/notify.elf"
+    }
+}
\ No newline at end of file
