From c2a543191f02608df8338e3284be2965bce9eb03 Mon Sep 17 00:00:00 2001
From: rmuxnet <116457149+rmuxnet@users.noreply.github.com>
Date: Sun, 22 Feb 2026 12:05:01 +0100
Subject: [PATCH] feat: add update banner and check button to templates

- Add update notification banner to index.html
- Add "Check for Updates" button in settings.html Advanced section
- Show app version in index.html footer
---
 templates/index.html    | 23 ++++++++++++++++++++++-
 templates/settings.html | 12 ++++++++++++
 2 files changed, 34 insertions(+), 1 deletion(-)

diff --git a/templates/index.html b/templates/index.html
index e0b4ba1..4e9830f 100644
--- a/templates/index.html
+++ b/templates/index.html
@@ -48,10 +48,31 @@
     <script src="{{ url_for('static', filename='index.js') }}" defer></script>
     <script src="{{ url_for('static', filename='clock.js') }}" defer></script>
     <script src="{{ url_for('static', filename='effects.js') }}" defer></script>
+    <script src="{{ url_for('static', filename='update_checker.js') }}" defer></script>
 </head>
 
 <body class="font-sans antialiased min-h-screen flex flex-col transition-colors duration-300 bg-gray-100 dark:bg-oled-base text-gray-900 dark:text-gray-200">
 
+<div id="update-banner" class="hidden w-full bg-gradient-to-r from-yellow-500/10 to-orange-500/10 border-b border-yellow-500/30 px-4 py-2.5">
+    <div class="max-w-4xl mx-auto flex items-center justify-between gap-4">
+        <div class="flex items-center gap-3 text-sm">
+            <i class="fa-solid fa-circle-up text-yellow-400 text-lg"></i>
+            <div>
+                <span id="update-message" class="font-bold text-yellow-300">Update available</span>
+                <span id="update-commits" class="text-xs opacity-60 ml-2"></span>
+            </div>
+        </div>
+        <div class="flex items-center gap-2">
+            <a id="update-link" href="#" target="_blank" class="text-xs font-bold bg-yellow-500/20 hover:bg-yellow-500/30 text-yellow-300 px-3 py-1.5 rounded-lg border border-yellow-500/30 transition-colors">
+                <i class="fa-brands fa-github mr-1"></i> View Update
+            </a>
+            <button onclick="dismissUpdate()" class="text-yellow-400/50 hover:text-yellow-400 transition-colors p-1">
+                <i class="fa-solid fa-xmark"></i>
+            </button>
+        </div>
+    </div>
+</div>
+
 <nav class="relative w-full border-b border-white/5">
     <div class="mx-auto px-4 sm:px-4 lg:px-8">
         <div class="relative flex h-16 items-center justify-between">
@@ -299,7 +320,7 @@ <h3 class="text-lg font-bold flex items-center gap-2">
 
         <div class="flex items-center gap-2">
             <i class="fa-solid fa-code-branch"></i>
-            <span>Y2JB WebUI</span>
+            <span>Y2JB WebUI <span id="app-version" class="text-brand-light">...</span></span>
         </div>
 
     </div>
diff --git a/templates/settings.html b/templates/settings.html
index 732d437..e950c15 100644
--- a/templates/settings.html
+++ b/templates/settings.html
@@ -182,6 +182,18 @@ <h2 class="text-lg font-bold mb-4 flex items-center gap-2 text-brand-light">
                     <div class="w-11 h-6 bg-gray-700 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-gray-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-brand-blue"></div>
                 </label>
             </div>
+
+            <div class="mt-4 p-4 bg-black/20 rounded-xl border border-white/5">
+                <div class="flex items-center justify-between">
+                    <div>
+                        <span class="block text-sm font-bold">Check for Updates</span>
+                        <span id="update-status-text" class="text-xs opacity-50">Compare local version with GitHub.</span>
+                    </div>
+                    <button onclick="manualUpdateCheck()" id="btn-update-check" class="px-4 py-2 bg-gray-700 hover:bg-brand-blue text-white rounded-lg text-xs font-bold transition-colors flex items-center gap-2">
+                        <i class="fa-solid fa-arrows-rotate" id="update-check-icon"></i> Check
+                    </button>
+                </div>
+            </div>
         </section>
 
     </main>
