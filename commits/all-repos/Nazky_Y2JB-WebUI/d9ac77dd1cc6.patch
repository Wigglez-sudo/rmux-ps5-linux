 static/settings.js       | 31 ++++++++++++++++++++++++++++
 static/update_checker.js | 44 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 83 insertions(+)
 create mode 100644 static/update_checker.js

diff --git a/static/index.js b/static/index.js
index ff50e99..0321790 100644
--- a/static/index.js
+++ b/static/index.js
@@ -21,6 +21,14 @@ document.addEventListener('DOMContentLoaded', () => {
             if (clientIpEl) clientIpEl.textContent = "Unknown";
         });
 
+    fetch("/api/update_check")
+        .then(r => r.json())
+        .then(data => {
+            const el = document.getElementById("app-version");
+            if (el && data.local_version) el.textContent = "v" + data.local_version;
