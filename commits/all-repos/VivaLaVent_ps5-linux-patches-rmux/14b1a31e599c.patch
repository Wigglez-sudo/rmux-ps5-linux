From 14b1a31e599cb64a509693e3853a54f4459400b9 Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Tue, 3 Nov 2026 09:33:03 +0100
Subject: [PATCH] Disable MT7921 PCIe Wi-Fi (testing)

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 .config   | 2 +-
 README.md | 3 +++
 2 files changed, 4 insertions(+), 1 deletion(-)

diff --git a/.config b/.config
index 22006c7..9b0e151 100644
--- a/.config
+++ b/.config
@@ -2644,7 +2644,7 @@ CONFIG_MT7663_USB_SDIO_COMMON=m
 CONFIG_MT7663U=m
 # CONFIG_MT7915E is not set
 CONFIG_MT7921_COMMON=m
-CONFIG_MT7921E=m
+# CONFIG_MT7921E is not set
 CONFIG_MT7921U=m
 # CONFIG_MT7996E is not set
 CONFIG_MT7925_COMMON=m
diff --git a/README.md b/README.md
index f8f8cd4..72f0f0d 100644
--- a/README.md
+++ b/README.md
@@ -72,6 +72,9 @@ The Wi-Fi driver (NXP mwifiex) is in `oot/mwifiex`, already patched for 7.3.
 `build.sh` copies it to `drivers/net/wireless/nxp-wlan` and builds it with the kernel.
 Nothing else is needed.
 
+MT7921 PCIe Wi-Fi (`CONFIG_MT7921E`) is testing and off by default.
+To turn it on, set `CONFIG_MT7921E=m` in `.config`.
+
 ### Roll back
 
 The script prints the backup folder. Copy the old files back:
