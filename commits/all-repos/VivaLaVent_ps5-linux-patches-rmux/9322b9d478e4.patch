-+		gbe_wr(p, GBE_REG_IER, GBE_IER_MASK);
-+		delay = max_t(unsigned long, 1, msecs_to_jiffies(GBE_POLL_FALLBACK_MS));
-+	}
 +	p->irq_watchdog = p->cnt_irq;
 +
