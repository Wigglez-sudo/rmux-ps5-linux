From fc76431e21aefe9702e1be0ac055b2b5b1e4f4db Mon Sep 17 00:00:00 2001
From: Armandas Kvietkus <armandas.kvietkus@proton.me>
Date: Mon, 2 Nov 2026 17:39:23 +0100
Subject: [PATCH] drm/amdgpu: drop GFX1013 MMIO TLB flush and GFXOFF guard

Signed-off-by: Armandas Kvietkus <armandas.kvietkus@proton.me>
---
 linux.patch | 151 ----------------------------------------------------
 1 file changed, 151 deletions(-)

diff --git a/linux.patch b/linux.patch
index 0b675cc..16f78dc 100644
--- a/linux.patch
+++ b/linux.patch
@@ -2010,35 +2010,6 @@ index a9c6f5d4a639..2b6333a2402d 100644
  static inline struct amdgpu_device *drm_to_adev(struct drm_device *ddev)
  {
  	return container_of(ddev, struct amdgpu_device, ddev);
-diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd.c
-index ca5860e493a6..61b8ae553352 100644
---- a/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd.c
-+++ b/drivers/gpu/drm/amd/amdgpu/amdgpu_amdkfd.c
-@@ -751,10 +751,21 @@ int amdgpu_amdkfd_submit_ib(struct amdgpu_device *adev,
- void amdgpu_amdkfd_set_compute_idle(struct amdgpu_device *adev, bool idle)
- {
- 	enum amd_powergating_state state = idle ? AMD_PG_STATE_GATE : AMD_PG_STATE_UNGATE;
--	if ((IP_VERSION_MAJ(amdgpu_ip_version(adev, GC_HWIP, 0)) == 11 &&
--	    ((adev->mes.kiq_version & AMDGPU_MES_VERSION_MASK) <= 64)) ||
--		(IP_VERSION_MAJ(amdgpu_ip_version(adev, GC_HWIP, 0)) == 12)) {
-+	bool gfx1013 = (adev->pdev->device == 0x13FE ||
-+			adev->pdev->device == 0x13FB) &&
-+		amdgpu_ip_version(adev, GC_HWIP, 0) == IP_VERSION(10, 1, 3);
-+	bool manage_gfxoff;
-+
-+	manage_gfxoff = (IP_VERSION_MAJ(amdgpu_ip_version(adev, GC_HWIP, 0)) == 11 &&
-+		((adev->mes.kiq_version & AMDGPU_MES_VERSION_MASK) <= 64)) ||
-+		(IP_VERSION_MAJ(amdgpu_ip_version(adev, GC_HWIP, 0)) == 12) || gfx1013;
-+
-+	if (manage_gfxoff) {
- 		pr_debug("GFXOFF is %s\n", idle ? "enabled" : "disabled");
-+		if (gfx1013)
-+			dev_dbg(adev->dev,
-+				"GFX1013 COMPUTE_GFXOFF_GUARD idle=%d action=%s\n",
-+				idle, idle ? "enable" : "disable");
- 		amdgpu_gfx_off_ctrl(adev, idle);
- 	} else if ((IP_VERSION_MAJ(amdgpu_ip_version(adev, GC_HWIP, 0)) == 9) &&
- 		(adev->flags & AMD_IS_APU)) {
 diff --git a/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c b/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c
 index 08ed1eb69558..71d9e999fdc9 100644
 --- a/drivers/gpu/drm/amd/amdgpu/amdgpu_bios.c
@@ -3007,128 +2978,6 @@ index 00798d80479f..621df344abca 100644
  	for (i = 0; i < adev->gfx.config.max_shader_engines; i++) {
  		for (j = 0; j < adev->gfx.config.max_sh_per_se; j++) {
  			bitmap = i * adev->gfx.config.max_sh_per_se + j;
-diff --git a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
-index c70657bc089b..c9117dfa2825 100644
---- a/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
-+++ b/drivers/gpu/drm/amd/amdgpu/gmc_v10_0.c
-@@ -232,12 +232,14 @@ static bool gmc_v10_0_get_atc_vmid_pasid_mapping_info(
-  *
-  * Flush the TLB for the requested page table.
-  */
--static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
--					uint32_t vmhub, uint32_t flush_type)
-+static void gmc_v10_0_flush_gpu_tlb_internal(struct amdgpu_device *adev,
-+					     uint32_t vmid, uint32_t vmhub,
-+					     uint32_t flush_type,
-+					     bool gfx1013_pasid_path)
- {
--	bool use_semaphore = gmc_v10_0_use_invalidate_semaphore(adev, vmhub);
-+	bool use_semaphore;
- 	struct amdgpu_vmhub *hub = &adev->vmhub[vmhub];
--	u32 inv_req = hub->vmhub_funcs->get_invalidate_req(vmid, flush_type);
-+	u32 inv_req;
- 	/* Use register 17 for GART */
- 	const unsigned int eng = 17;
- 	unsigned char hub_ip = 0;
-@@ -245,6 +247,14 @@ static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
- 	unsigned int i;
- 	u32 tmp;
- 
-+	if (gfx1013_pasid_path && vmhub == AMDGPU_GFXHUB(0) &&
-+	    flush_type == 2)
-+		flush_type = 0;
-+
-+	use_semaphore = gmc_v10_0_use_invalidate_semaphore(adev, vmhub) ||
-+		(gfx1013_pasid_path && vmhub == AMDGPU_GFXHUB(0));
-+	inv_req = hub->vmhub_funcs->get_invalidate_req(vmid, flush_type);
-+
- 	sem = hub->vm_inv_eng0_sem + hub->eng_distance * eng;
- 	req = hub->vm_inv_eng0_req + hub->eng_distance * eng;
- 	ack = hub->vm_inv_eng0_ack + hub->eng_distance * eng;
-@@ -255,7 +265,8 @@ static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
- 	/* This is necessary for SRIOV as well as for GFXOFF to function
- 	 * properly under bare metal
- 	 */
--	if (adev->gfx.kiq[0].ring.sched.ready && !adev->enable_mes &&
-+	if (!gfx1013_pasid_path &&
-+	    adev->gfx.kiq[0].ring.sched.ready && !adev->enable_mes &&
- 	    (amdgpu_sriov_runtime(adev) || !amdgpu_sriov_vf(adev))) {
- 		amdgpu_gmc_fw_reg_write_reg_wait(adev, req, ack, inv_req,
- 						 1 << vmid, GET_INST(GC, 0));
-@@ -318,6 +329,13 @@ static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
- 			vmhub);
- }
- 
-+static void gmc_v10_0_flush_gpu_tlb(struct amdgpu_device *adev, uint32_t vmid,
-+					uint32_t vmhub, uint32_t flush_type)
-+{
-+	gmc_v10_0_flush_gpu_tlb_internal(adev, vmid, vmhub, flush_type,
-+					   false);
-+}
-+
- /**
-  * gmc_v10_0_flush_gpu_tlb_pasid - tlb flush via pasid
-  *
-@@ -335,6 +353,10 @@ static void gmc_v10_0_flush_gpu_tlb_pasid(struct amdgpu_device *adev,
- {
- 	uint16_t queried;
- 	int vmid, i;
-+	bool gfx1013_pasid_path =
-+		(adev->pdev->device == 0x13FE ||
-+		 adev->pdev->device == 0x13FB) &&
-+		amdgpu_ip_version(adev, GC_HWIP, 0) == IP_VERSION(10, 1, 3);
- 
- 	for (vmid = 1; vmid < AMDGPU_NUM_VMID; vmid++) {
- 		bool valid;
-@@ -347,11 +369,21 @@ static void gmc_v10_0_flush_gpu_tlb_pasid(struct amdgpu_device *adev,
- 		if (all_hub) {
- 			for_each_set_bit(i, adev->vmhubs_mask,
- 					 AMDGPU_MAX_VMHUBS)
--				gmc_v10_0_flush_gpu_tlb(adev, vmid, i,
--							flush_type);
-+				if (gfx1013_pasid_path)
-+					gmc_v10_0_flush_gpu_tlb_internal(
-+						adev, vmid, i, flush_type, true);
-+				else
-+					gmc_v10_0_flush_gpu_tlb(
-+						adev, vmid, i, flush_type);
- 		} else {
--			gmc_v10_0_flush_gpu_tlb(adev, vmid, AMDGPU_GFXHUB(0),
--						flush_type);
-+			if (gfx1013_pasid_path)
-+				gmc_v10_0_flush_gpu_tlb_internal(
-+					adev, vmid, AMDGPU_GFXHUB(0),
-+					flush_type, true);
-+			else
-+				gmc_v10_0_flush_gpu_tlb(
-+					adev, vmid, AMDGPU_GFXHUB(0),
-+					flush_type);
- 		}
- 	}
- }
-@@ -960,7 +992,21 @@ static int gmc_v10_0_hw_init(struct amdgpu_ip_block *ip_block)
- 	struct amdgpu_device *adev = ip_block->adev;
- 	int r;
- 
--	adev->gmc.flush_pasid_uses_kiq = !amdgpu_emu_mode;
-+	/*
-+	 * GFX1013/BC-250/PS5: KIQ-routed PASID TLB invalidation can corrupt
-+	 * sustained KFD workloads.  Keep the existing behavior for every
-+	 * other GMC v10 device and route only GFX1013 through MMIO.
-+	 */
-+	adev->gmc.flush_pasid_uses_kiq = !amdgpu_emu_mode &&
-+		amdgpu_ip_version(adev, GC_HWIP, 0) != IP_VERSION(10, 1, 3);
-+	if (!adev->gmc.flush_pasid_uses_kiq &&
-+	    amdgpu_ip_version(adev, GC_HWIP, 0) == IP_VERSION(10, 1, 3))
-+		dev_info(adev->dev,
-+			 "GFX1013/BC-250/PS5: using MMIO PASID TLB flushes\n");
-+
-+	if (amdgpu_ip_version(adev, GC_HWIP, 0) == IP_VERSION(10, 1, 3))
-+		dev_info(adev->dev,
-+			 "GFX1013/BC-250/PS5: PASID-only CPU type-0 invalidation\n");
- 
- 	/* The sequence of these two function calls matters.*/
- 	gmc_v10_0_init_golden_registers(adev);
 diff --git a/drivers/gpu/drm/amd/amdgpu/nv.c b/drivers/gpu/drm/amd/amdgpu/nv.c
 index 96faaf8c5737..4dd74a34cc61 100644
 --- a/drivers/gpu/drm/amd/amdgpu/nv.c
