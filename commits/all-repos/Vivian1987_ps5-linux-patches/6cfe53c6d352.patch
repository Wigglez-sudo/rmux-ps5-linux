From 6cfe53c6d35223b6802dbc639858f55b536ecff9 Mon Sep 17 00:00:00 2001
From: rmux <armandas.kvietkus@proton.me>
Date: Sun, 28 Jun 2026 15:59:14 +0200
Subject: [PATCH] feat: add PS5 LED driver (#21)

usage:
  # list presets
  ls /sys/class/leds/

  # set a preset
  echo 255 > /sys/class/leds/ps5:<preset>:indicator/brightness

  # turn off
  echo 0 > /sys/class/leds/ps5:off:indicator/brightness
---
