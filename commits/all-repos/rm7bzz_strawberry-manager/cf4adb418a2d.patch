+/*
+Required palette, mapped into GTK named colors.
+:root {
+  --strawberry:        #ff4d78;
+  --strawberry-bright: #ff7096;
+  --strawberry-glow:   rgba(255, 77, 120, 0.28);
+  --strawberry-subtle: rgba(255, 77, 120, 0.12);
+  --glass-bg:          rgba(20, 3, 10, 0.80);
+  --glass-border:      rgba(255, 77, 120, 0.18);
+  --bg:                #0d0106;
+  --bg-off:            #160310;
+  --text-main:         #e8b0c0;
+  --text-dim:          #804060;
+  --text-hi:           #ffd6e3;
+  --border-c:          #350a1e;
+  --border-dim-c:      #804060;
+}
+*/
+
+@define-color strawberry #ff4d78;
+@define-color strawberry_bright #ff7096;
+@define-color strawberry_glow rgba(255, 77, 120, 0.28);
+@define-color strawberry_subtle rgba(255, 77, 120, 0.12);
+@define-color glass_bg rgba(20, 3, 10, 0.80);
+@define-color glass_border rgba(255, 77, 120, 0.18);
+@define-color bg #0d0106;
+@define-color bg_off #160310;
+@define-color text_main #e8b0c0;
+@define-color text_dim #804060;
+@define-color text_hi #ffd6e3;
+@define-color border_c #350a1e;
+@define-color border_dim_c #804060;
+
+window,
+.app-root,
+scrolledwindow,
+scrolledwindow > viewport {
+  background-color: @bg;
+  color: @text_main;
+}
+
+label {
+  color: @text_main;
+}
+
+.glass-card {
+  background-image:
+    linear-gradient(180deg, rgba(255, 112, 150, 0.04), rgba(20, 3, 10, 0.02)),
