+++ b/.config
@@ -2402,6 +2402,7 @@ CONFIG_SMSC_PHY=m
 # CONFIG_DP83TG720_PHY is not set
 # CONFIG_VITESSE_PHY is not set
 # CONFIG_XILINX_GMII2RGMII is not set
