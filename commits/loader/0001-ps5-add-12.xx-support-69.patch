From 0ee46a156c3aa1b8b0e52bffc40b969259212cd4 Mon Sep 17 00:00:00 2001
From: rmuxnet <armandas.kvietkus@proton.me>
Date: Sat, 24 Oct 2026 23:09:54 -0700
Subject: [PATCH] ps5: add 12.xx support (#69)

* ps5: add 12.xx support

thanks for everything to my goat https://github.com/Wigglez-sudo

* ps5: add explicit 12.20 offsets
---
 include/config.h        |   3 +
 include/offsets.h       |   5 +
 shellcode_kernel/main.c |   2 +-
 source/hv_defeat_13xx.c |   9 +-
 source/main.c           |   3 +-
 source/offsets.c        | 315 ++++++++++++++++++++++++++++++++++++++++
 source/prepare_resume.c |  10 +-
 source/utils.c          |  16 ++
 8 files changed, 355 insertions(+), 8 deletions(-)

diff --git a/include/config.h b/include/config.h
index 1e688a3..fe96f41 100644
--- a/include/config.h
+++ b/include/config.h
@@ -6,6 +6,9 @@
 /* Firmwares that use the 11.x Sonic carrier and hypervisor-defeat path. */
 #define PS5_FW_IS_11XX(fw)                                                     \
   ((fw) == 0x1100 || (fw) == 0x1120 || (fw) == 0x1140 || (fw) == 0x1160)
+#define PS5_FW_IS_12XX(fw)                                                     \
+  ((fw) == 0x1200 || (fw) == 0x1202 || (fw) == 0x1220 || (fw) == 0x1240 ||   \
+   (fw) == 0x1260 || (fw) == 0x1270)
 
 // This is used to allocate resources for HV shellcode and Linux boot
 #define cave 0x100000000ULL
diff --git a/include/offsets.h b/include/offsets.h
index 3f945ac..780b10c 100644
--- a/include/offsets.h
+++ b/include/offsets.h
@@ -103,6 +103,11 @@ extern offset_list off_1100;
 extern offset_list off_1120;
 extern offset_list off_1140;
 extern offset_list off_1160;
+extern offset_list off_1200;
+extern offset_list off_1202;
+extern offset_list off_1220;
+extern offset_list off_1240;
+extern offset_list off_1270;
 extern offset_list off_1300;
 extern offset_list off_1320;
 extern offset_list off_1340;
diff --git a/shellcode_kernel/main.c b/shellcode_kernel/main.c
index 3d6ed68..3f4d6a7 100644
--- a/shellcode_kernel/main.c
+++ b/shellcode_kernel/main.c
@@ -29,7 +29,7 @@ __attribute__((section(".entry_point"))) uint32_t main(uint64_t add1,
   }
 
 #if defined(FW_13XX_PORT)
-  if (args_ptr->fw_version < 0x1300 || args_ptr->fw_version >= 0x1400)
+  if (args_ptr->fw_version < 0x1200 || args_ptr->fw_version >= 0x1400)
     return -1;
   activate_uart(args_ptr);
 #elif defined(FW_1160)
diff --git a/source/hv_defeat_13xx.c b/source/hv_defeat_13xx.c
index 42a5e92..24626a9 100644
--- a/source/hv_defeat_13xx.c
+++ b/source/hv_defeat_13xx.c
@@ -97,7 +97,8 @@ uint64_t kgadget(kgadget_t gadget) {
 }
 
 static int offsets_present(void) {
-  if (fw != 0x1300 && fw != 0x1320 && fw != 0x1340 && fw != 0x1342 && fw != 0x1360)
+  if (!PS5_FW_IS_12XX(fw) && fw != 0x1300 && fw != 0x1320 && fw != 0x1340 &&
+      fw != 0x1342 && fw != 0x1360)
     return 0;
 
   const uint64_t required[] = {
@@ -185,6 +186,9 @@ static int check_nvs_signature(void) {
 uint64_t derive_h(void) {
   uint64_t record;
 
+  if (!env_offset.HV_EFI_MAP_ROOT)
+    return 0;
+
   if (kernel_read(ktext + env_offset.HV_EFI_MAP_ROOT, &record, sizeof(record)) ||
       !record || (record >> 47) != 0x1FFFF)
     return 0;
@@ -400,7 +404,8 @@ int hv_defeat_13xx(void *shellcode_kernel, size_t shellcode_kernel_len) {
   uint64_t waking_vector;
   int result;
 
-  if ((fw != 0x1300 && fw != 0x1320 && fw != 0x1340 && fw != 0x1342 && fw != 0x1360) || !shellcode_kernel ||
+  if ((!PS5_FW_IS_12XX(fw) && fw != 0x1300 && fw != 0x1320 && fw != 0x1340 &&
+       fw != 0x1342 && fw != 0x1360) || !shellcode_kernel ||
       !shellcode_kernel_len || !offsets_present()) {
     if (fw == 0x1360)
       notify("13.60 offsets incomplete\n");
diff --git a/source/main.c b/source/main.c
index 56d1f0d..b6e1372 100644
--- a/source/main.c
+++ b/source/main.c
@@ -48,7 +48,8 @@ int main(void) {
   } else if ((0x0650 <= fw) && (fw < 0x0800)) {
     if (hv_defeat_0607(shellcode_kernel, shellcode_kernel_len))
       goto err;
-  } else if (fw == 0x1300 || fw == 0x1320 || fw == 0x1340 || fw == 0x1342 || fw == 0x1360) {
+  } else if (PS5_FW_IS_12XX(fw) || fw == 0x1300 || fw == 0x1320 ||
+             fw == 0x1340 || fw == 0x1342 || fw == 0x1360) {
     if (hv_defeat_13xx(shellcode_kernel, shellcode_kernel_len))
       goto err;
   } else if (PS5_FW_IS_11XX(fw)) {
